COMPOSE_PROJECT_NAME=zhixin-ai-production
NEXT_PUBLIC_DESKTOP_DOWNLOAD_URL=/downloads/zhixin-ai-windows.exe
POSTGRES_DB=zhixin_ai
POSTGRES_USER=zhixin
POSTGRES_PASSWORD=replace_with_random_alphanumeric_secret
REDIS_PASSWORD=replace_with_random_alphanumeric_secret

AUTH_ALLOWED_ORIGINS=https://zhixin.example.com
AUTH_TRUSTED_HOSTS=zhixin.example.com,localhost,127.0.0.1,api
AUTH_REGISTRATION_ENABLED=true
AUTH_EMAIL_DELIVERY=smtp
AUTH_DEBUG_RETURN_CODE=false
AUTH_CODE_TTL_SECONDS=600
AUTH_CODE_MAX_ATTEMPTS=5
AUTH_SESSION_TTL_DAYS=30
AUTH_COOKIE_NAME=zhixin_session
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=none
AUTH_SMTP_HOST=smtp.example.com
AUTH_SMTP_PORT=465
AUTH_SMTP_USERNAME=noreply@example.com
AUTH_SMTP_PASSWORD=replace_with_directmail_smtp_password
AUTH_SMTP_FROM_EMAIL=noreply@example.com
AUTH_SMTP_FROM_NAME=智心AI
AUTH_SMTP_USE_SSL=true
AUTH_SMTP_STARTTLS=false
AUTH_SMTP_TIMEOUT_SECONDS=15
AUTH_RATE_LIMIT_ENABLED=true
AUTH_REGISTER_CODE_EMAIL_LIMIT=5
AUTH_REGISTER_CODE_IP_LIMIT=20
AUTH_LOGIN_EMAIL_LIMIT=10
AUTH_LOGIN_IP_LIMIT=60
AUTH_RATE_LIMIT_WINDOW_SECONDS=900

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_OFFLINE_MODE=false
ARTICLE_TEXT_PROVIDER=deepseek
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_TEXT_MODEL=gemini-3.5-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_OFFLINE_MODE=false
ARTICLE_IMAGE_PROVIDER=step
STEP_API_KEY=
STEP_BASE_URL=https://api.stepfun.com
STEP_IMAGE_MODEL=step-image-edit-2

DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
SEO_PROVIDER_BASE_URL=
SEO_PROVIDER_API_KEY=
MEDIA_PUBLISH_FALLBACK_MOCK=false
KNOWLEDGE_FETCH_MODE=auto
KNOWLEDGE_FETCH_STEALTH=true
KNOWLEDGE_FETCH_TIMEOUT=30
KNOWLEDGE_FETCH_STEALTH_TIMEOUT_MS=45000
QUEUE_LEASE_SECONDS=300
QUEUE_MAX_ATTEMPTS=3
QUEUE_POLL_INTERVAL=0.1
