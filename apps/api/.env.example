DATABASE_URL=postgresql+psycopg://zhixin:zhixin@127.0.0.1:5432/zhixin_ai
REDIS_URL=redis://127.0.0.1:6379/0
QUEUE_LEASE_SECONDS=300
QUEUE_MAX_ATTEMPTS=3
QUEUE_POLL_INTERVAL=0.1
API_HOST=127.0.0.1
API_PORT=8000
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_OFFLINE_MODE=false
ARTICLE_TEXT_PROVIDER=deepseek
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_TEXT_MODEL=gemini-3.5-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_OFFLINE_MODE=false
ARTICLE_IMAGE_PROVIDER=step
STEP_API_KEY=
STEP_BASE_URL=https://api.stepfun.com
STEP_IMAGE_MODEL=step-image-edit-2
UPLOAD_DIR=apps/api/uploads

# Registration verifies email once; later sign-in uses email and password.
AUTH_REGISTRATION_ENABLED=true
AUTH_EMAIL_DELIVERY=console
AUTH_DEBUG_RETURN_CODE=true
AUTH_CODE_TTL_SECONDS=600
AUTH_CODE_MAX_ATTEMPTS=5
AUTH_SESSION_TTL_DAYS=30
AUTH_COOKIE_NAME=zhixin_session
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_TEST_BYPASS_USER_ID=

# Set AUTH_EMAIL_DELIVERY=smtp for shared/cloud environments.
AUTH_SMTP_HOST=
AUTH_SMTP_PORT=587
AUTH_SMTP_USERNAME=
AUTH_SMTP_PASSWORD=
AUTH_SMTP_FROM_EMAIL=
AUTH_SMTP_FROM_NAME=智心AI
AUTH_SMTP_USE_SSL=false
AUTH_SMTP_STARTTLS=true
AUTH_SMTP_TIMEOUT_SECONDS=15
SEO_PROVIDER_BASE_URL=
SEO_PROVIDER_API_KEY=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Knowledge URL fetch (Scrapling: https://github.com/D4Vinci/Scrapling)
# auto = Scrapling HTTP fingerprint first, hard sites use stealth browser, then httpx
KNOWLEDGE_FETCH_MODE=auto
KNOWLEDGE_FETCH_STEALTH=true
KNOWLEDGE_FETCH_TIMEOUT=30
KNOWLEDGE_FETCH_STEALTH_TIMEOUT_MS=45000

# Google Search Console service-account JSON, base64 encoded.
GOOGLE_SEARCH_CONSOLE_CREDENTIALS_JSON_B64=
GOOGLE_SEARCH_CONSOLE_SITE_URL=
GOOGLE_SEARCH_CONSOLE_SITEMAP_URL=

# Baidu Search Resource Platform normal-push credentials.
BAIDU_SEARCH_SITE_URL=
BAIDU_SEARCH_TOKEN=

# IndexNow key and publicly reachable key-file URL.
INDEXNOW_KEY=
INDEXNOW_KEY_LOCATION=
