# Database and queue
DATABASE_URL="postgresql+psycopg://zhixin:zhixin@127.0.0.1:5432/zhixin_ai"
REDIS_URL="redis://127.0.0.1:6379/0"

# DeepSeek article generation
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-v4-pro"
DEEPSEEK_OFFLINE_MODE=false

# API storage
UPLOAD_DIR="apps/api/uploads"

# Optional generic SEO data adapter
SEO_PROVIDER_BASE_URL=""
SEO_PROVIDER_API_KEY=""

# DataForSEO is used to observe Google/Baidu/Bing results for external media URLs.
# A positive exact-URL match is evidence of inclusion; no match is not proof of exclusion.
DATAFORSEO_LOGIN=""
DATAFORSEO_PASSWORD=""

# Google Search Console
# Encode the service-account JSON as base64 before assigning it here.
# Add the service-account email as a user of the configured Search Console property.
GOOGLE_SEARCH_CONSOLE_CREDENTIALS_JSON_B64=""
GOOGLE_SEARCH_CONSOLE_SITE_URL=""
GOOGLE_SEARCH_CONSOLE_SITEMAP_URL=""

# Baidu Search Resource Platform normal push
BAIDU_SEARCH_SITE_URL=""
BAIDU_SEARCH_TOKEN=""

# IndexNow
# The key file must be publicly reachable on the same host as submitted URLs.
INDEXNOW_KEY=""
INDEXNOW_KEY_LOCATION=""

# Legacy compatibility only. HTTP reachability is stored separately and never means indexed.
INCLUSION_CHECK_METHOD="provider"

# Soft-media publishing fallback
MEDIA_PUBLISH_FALLBACK_MOCK=true

# Next.js
NEXT_PUBLIC_APP_NAME="智心AI"
# FASTAPI_BASE_URL="http://127.0.0.1:8000"
